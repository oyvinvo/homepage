# ==============================================================================
# Environment Variables Example - AGV Portfolio Application
# KulturIT Operations Standard
# ==============================================================================

# Application Port
PORT=8080

# Environment Mode (development | production | test)
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Relational Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agv_portfolio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/agv_portfolio_dev
