@startuml
!include C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram - Package-by-Feature Bilingual Architecture

Container_Boundary(spa_container, "Modern Minimalist Architect Portfolio SPA") {

    package "src/i18n (Zero-Dependency Type-Safe Bilingual Localization Core)" {
        Component(language_toggle, "LanguageToggle", "React Component", "Accessible interactive toggle (NO | EN) with dynamic aria-label, high-contrast active state, and keyboard support.")
        Component(use_translation, "useTranslation", "React Hook", "Custom hook binding Zustand language state to active typed dictionary.")
        Component(language_calculator, "LanguageCalculator", "Calculator", "Pure calculator: resolves initial locale from localStorage/navigator, toggles language, and formats ARIA descriptions.")
        Component(translation_dictionaries, "translationDictionaries", "Data Catalog", "Strict compile-time typed dual dictionaries: Norwegian Bokmål ('no') and English ('en').")
    }

    package "src/navigation (Header, Skip Link, Language Toggle & Navigation)" {
        Component(sticky_navbar, "StickyNavbar", "React Component", "Header banner with branding, navigation links, LanguageToggle, theme toggle, and Full CV modal trigger.")
        Component(skip_link, "SkipLink", "React Component", "Keyboard-accessible skip link focusing <main id='main-content'>.")
        Component(mobile_menu, "NavbarMobileMenu", "React Component", "Accessible mobile drawer overlay with localized links and LanguageToggle.")
        Component(section_observer, "SectionObserverService", "Service", "IntersectionObserver syncing viewport sections to active navigation pill.")
    }

    package "src/hero (Executive Positioning, Verified Metrics & CTAs)" {
        Component(hero_section, "HeroSection", "React Component", "Primary hero landmark (<section id='hero'>).")
        Component(availability_badge, "AvailabilityBadge", "React Component", "Pulsing indicator: Available for Architecture Leadership & Technical Advisory.")
        Component(metrics_strip, "HeroMetricsStrip", "React Component", "4 high-impact metric counters with localized labels.")
        Component(hero_actions, "HeroActionButtons", "React Component", "Quick action buttons linking to Projects, Experience, CV Drawer, and Contact.")
    }

    package "src/leadership (Architecture Philosophy, Governance & Guild)" {
        Component(leadership_section, "LeadershipSection", "React Component", "Section container (<section id='leadership'>).")
        Component(philosophy_card, "PhilosophyPillarCard", "React Component", "Card component for the 4 pillars: DDD, ADRs, Microservices, Mentorship.")
        Component(governance_card, "GuildGovernanceCard", "React Component", "Exposition on Head of Architect Group role and spec-driven engineering.")
    }

    package "src/experience (Career Chronology & Deliverable Milestones)" {
        Component(experience_section, "ExperienceSection", "React Component", "Section container (<section id='experience'>).")
        Component(timeline_card, "ExperienceMilestoneCard", "React Component", "Reverse chronological milestone card with localized role, summary, and highlights.")
        Component(education_card, "ExperienceEducationCard", "React Component", "Academic card presenting Cand.Mag. / Informatics degree from UiO.")
        Component(experience_catalog, "experienceCatalog", "Data Catalog", "Enriched milestone records for Norwegian Bokmål and English.")
    }

    package "src/projects (Flagship Case Studies, Category Filter & Search)" {
        Component(projects_section, "ProjectsSection", "React Component", "Section container (<section id='projects'>) orchestrating filter tabs, search bar, and grid.")
        Component(filter_bar, "ProjectFilterBar", "React Component", "Localized category tabs and live search input.")
        Component(project_card, "ProjectCard", "React Component", "Detailed case study card with localized challenge, solution, metrics, and tech stack.")
        Component(projects_catalog, "projectsCatalog", "Data Catalog", "6 flagship case studies with dual-language technical dossiers.")
    }

    package "src/skills (4-Quadrant Core Competency Matrix)" {
        Component(skills_section, "SkillsSection", "React Component", "Section container (<section id='skills'>).")
        Component(quadrant_card, "SkillQuadrantCard", "React Component", "Thematic category card with localized titles and proficiency tags.")
        Component(skills_catalog, "skillsCatalog", "Data Catalog", "4-quadrant skill inventories with localized descriptors.")
    }

    package "src/contact (Recruiter Dock, Clipboard & Notifications)" {
        Component(contact_section, "ContactSection", "React Component", "Section container (<section id='contact'>) with calm peer-networking tone.")
        Component(recruiter_dock, "RecruiterDock", "React Component", "1-click actions: [Copy Email], [LinkedIn], [GitHub], [Open CV].")
        Component(toast_container, "ToastContainer", "React Component", "Accessible status region (role='status', aria-live='polite') for localized feedback.")
        Component(clipboard_service, "ClipboardService", "Service", "Manages clipboard writes with multi-tier fallback.")
    }

    package "src/manifest (Full CV Drawer Modal & Clean Print Engine)" {
        Component(cv_drawer, "CVManifestDrawer", "React Component", "Accessible slide-over WAI-ARIA dialog with keyboard focus trap.")
        Component(cv_print, "CvPrintManifest", "CSS / DOM", "Hidden-on-screen, visible-on-print resume document formatted via @media print in active locale.")
    }

    package "src/shared (Domain Calculators, State Store & Contracts)" {
        Component(portfolio_store, "portfolioStore", "Zustand Store", "Central reactive state: language ('no' | 'en'), activeSection, selectedCategory, searchQuery, isCvDrawerOpen, toast.")
        Component(filter_calculator, "ProjectFilterCalculator", "Calculator", "Pure calculator: filters case studies by category and case-insensitive search queries.")
        Component(clipboard_calculator, "ClipboardActionCalculator", "Calculator", "Pure calculator: determines clipboard strategy and formats feedback.")
        Component(reading_calculator, "ReadingTimeCalculator", "Calculator", "Pure calculator: computes estimated reading time for dossiers.")
    }
}

Rel(sticky_navbar, language_toggle, "Renders desktop language switch", "JSX")
Rel(mobile_menu, language_toggle, "Renders mobile drawer language switch", "JSX")
Rel(language_toggle, portfolio_store, "Reads language; dispatches toggleLanguage / setLanguage", "Store Action")
Rel(language_toggle, language_calculator, "Calculates next language and accessible ARIA labels", "Pure Function")

Rel(use_translation, portfolio_store, "Subscribes to language state slice", "Zustand Hook")
Rel(use_translation, translation_dictionaries, "Selects active dictionary (no / en)", "Direct Lookup")

Rel(sticky_navbar, use_translation, "Gets localized nav links & aria labels", "Hook Call")
Rel(mobile_menu, use_translation, "Gets localized drawer actions", "Hook Call")
Rel(hero_section, use_translation, "Gets localized executive headline, bio, metrics & CTAs", "Hook Call")
Rel(leadership_section, use_translation, "Gets localized 4 pillars & quote", "Hook Call")
Rel(experience_section, use_translation, "Gets localized section copy & milestone chronology", "Hook Call")
Rel(projects_section, use_translation, "Gets localized search placeholder & category labels", "Hook Call")
Rel(skills_section, use_translation, "Gets localized competency quadrants & proficiency tags", "Hook Call")
Rel(contact_section, use_translation, "Gets localized availability badge & copy feedback", "Hook Call")
Rel(cv_drawer, use_translation, "Gets localized resume headings & actions", "Hook Call")

Rel(sticky_navbar, portfolio_store, "Reads activeSection; dispatches setIsCvDrawerOpen", "State Hook")
Rel(sticky_navbar, section_observer, "Observes visible landmarks", "DOM Events")
Rel(projects_section, filter_bar, "Renders filter tabs & search input", "JSX")
Rel(projects_section, project_card, "Renders filtered list", "JSX")
Rel(filter_bar, portfolio_store, "Dispatches setSelectedCategory and setSearchQuery", "Store Action")
Rel(projects_section, filter_calculator, "Filters projects by category and query", "Pure Function")
Rel(filter_bar, filter_calculator, "Calculates category item counts", "Pure Function")
Rel(project_card, reading_calculator, "Calculates reading time", "Pure Function")

Rel(recruiter_dock, clipboard_service, "Invokes email copy", "Async Method Call")
Rel(clipboard_service, clipboard_calculator, "Resolves strategy & toast message", "Pure Function")
Rel(clipboard_service, portfolio_store, "Dispatches setToast", "Store Action")
Rel(toast_container, portfolio_store, "Subscribes to toast state", "State Hook")

Rel(cv_drawer, portfolio_store, "Reads isCvDrawerOpen; dispatches setIsCvDrawerOpen", "State Hook")
Rel(cv_drawer, experience_catalog, "Binds localized milestone chronology", "Imports")
Rel(cv_drawer, skills_catalog, "Binds localized competencies", "Imports")

Rel(experience_section, experience_catalog, "Binds localized milestones", "Imports")
Rel(projects_section, projects_catalog, "Binds localized flagship case studies", "Imports")
Rel(skills_section, skills_catalog, "Binds localized 4-quadrant competencies", "Imports")

@enduml
