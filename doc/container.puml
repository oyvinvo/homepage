@startuml
!include C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram - Modern Minimalist Zero-3D Bilingual Architect Portfolio

Person(user, "Recruiter / Architect / Visitor", "Modern desktop or mobile web browser client.")

System_Boundary(spa_boundary, "Modern Minimalist Architect Portfolio SPA (Vite + React 18)") {
    Container(nav_container, "Navigation & Header", "React / Tailwind CSS", "Sticky header banner, accessible keyboard skip link, section observer highlights, Full CV modal trigger, and LanguageToggle.")
    Container(i18n_engine, "Bilingual Localization Engine", "React / TypeScript", "Zero-dependency type-safe dictionary engine (NO/EN), useTranslation hook, and accessible LanguageToggle.")
    Container(hero_container, "Hero & Executive Metrics", "React / Tailwind CSS", "Executive positioning, role subtitle, availability indicator, 4 verified impact metric cards, and quick CTAs in active locale.")
    Container(leadership_container, "Leadership & Philosophy", "React / Tailwind CSS", "Head of Architect Group mandate, ADR governance workflows, and 4 architectural philosophy pillars in active locale.")
    Container(experience_container, "Experience Timeline", "React / Tailwind CSS", "Chronological career milestones highlighting KulturIT architecture leadership (E-ARK, API fabric, VirtueltMuseum) and public sector deliverables in active locale.")
    Container(projects_container, "Featured Case Studies", "React / Tailwind CSS", "Flagship technical dossiers (eKultur Handover, VirtueltMuseum, eKultur Core Gateway, eKultur AI Vision, Autosys KSAK, Regelforvaltning) with localized category tabs, search, and details.")
    Container(skills_container, "Competency Matrix", "React / Tailwind CSS", "4-quadrant competency grid with localized quadrant titles, descriptions, and proficiency tags.")
    Container(contact_container, "Recruiter Dock & Toast Region", "React / Tailwind CSS", "1-click clipboard email copy, external profile links, localized availability badge, and accessible aria-live toast notification region.")
    Container(manifest_container, "CV Manifest & Print Engine", "React / Tailwind CSS", "Accessible WAI-ARIA modal drawer with focus trap and @media print formatted curriculum vitae rendered in active locale.")
    Container(state_store, "Zustand Portfolio Store", "Zustand 5", "Manages language ('no' | 'en'), active section, project filter category, search query, CV drawer modal state, and toast notification queue.")
    Container(domain_calculators, "Pure Domain Calculators", "TypeScript Class", "Pure deterministic logic: LanguageCalculator (locale detection & toggling), ProjectFilterCalculator, ClipboardActionCalculator, ReadingTimeCalculator.")
    Container(domain_catalogs, "Domain Catalogs & Dictionaries", "TypeScript DTOs", "Immutable production records and type-safe translation dictionaries for Norwegian Bokmål and English.")
}

System_Ext(browser_dom, "Browser DOM & Window", "Standard semantic HTML5 tree, focus management, localStorage persistence ('portfolio-language'), and dynamic <html lang> synchronization.")
System_Ext(browser_clipboard, "Browser Clipboard API", "Async Clipboard API with execCommand fallback for 1-click email copy.")
System_Ext(browser_print, "Browser Print Subsystem", "Native print pipeline formatting ink-friendly curriculum vitae via @media print.")
System_Ext(external_links, "External Profiles & Repositories", "LinkedIn, GitHub, and live reference links.")

Rel(user, nav_container, "Clicks nav links, activates skip link, toggles language, opens CV drawer", "Keyboard / Pointer")
Rel(user, hero_container, "Reads executive metrics and activates quick actions", "Visual / Pointer")
Rel(user, projects_container, "Toggles category filter pills and enters search queries", "Pointer / Keyboard")
Rel(user, contact_container, "Clicks [Copy Email], accesses LinkedIn & GitHub", "Pointer / Keyboard")
Rel(user, manifest_container, "Navigates CV drawer (trapped focus) or invokes [Print]", "Keyboard / Pointer")

Rel(nav_container, i18n_engine, "Renders LanguageToggle in desktop header and mobile menu", "JSX")
Rel(i18n_engine, state_store, "Reads active language; dispatches setLanguage and toggleLanguage", "Zustand Hook")
Rel(i18n_engine, domain_calculators, "Calculates initial locale and metadata via LanguageCalculator", "Pure Method Calls")
Rel(i18n_engine, domain_catalogs, "Resolves type-safe dictionaries for active locale", "Imports")

Rel(nav_container, state_store, "Reads activeSection & language; dispatches setActiveSection and openCvDrawer", "Zustand Hook")
Rel(projects_container, state_store, "Reads selectedCategory, searchQuery & language; dispatches updates", "Zustand Hook")
Rel(projects_container, domain_calculators, "Filters case studies and calculates counts via ProjectFilterCalculator", "Method Calls")
Rel(contact_container, state_store, "Dispatches showToast upon clipboard write", "Zustand Actions")
Rel(contact_container, domain_calculators, "Resolves clipboard strategy via ClipboardActionCalculator", "Method Calls")
Rel(manifest_container, state_store, "Reads isCvDrawerOpen & language; dispatches closeCvDrawer", "Zustand Hook")

Rel(hero_container, domain_catalogs, "Reads localized metrics & executive bio", "Imports / Hooks")
Rel(experience_container, domain_catalogs, "Reads localized career milestone records", "Imports / Hooks")
Rel(projects_container, domain_catalogs, "Reads localized flagship project dossiers", "Imports / Hooks")
Rel(skills_container, domain_catalogs, "Reads localized 4-quadrant skill inventories", "Imports / Hooks")
Rel(manifest_container, domain_catalogs, "Reads localized comprehensive curriculum vitae data", "Imports / Hooks")

Rel(state_store, browser_dom, "Synchronizes document.documentElement.lang and persists to localStorage", "DOM / Storage API")
Rel(nav_container, browser_dom, "Observes viewport scroll intersections", "IntersectionObserver")
Rel(contact_container, browser_clipboard, "Writes email string to system clipboard", "navigator.clipboard")
Rel(manifest_container, browser_print, "Invokes window.print()", "Native Print API")
Rel(contact_container, external_links, "Navigates to external profiles", "HTTPS Anchors")

@enduml
